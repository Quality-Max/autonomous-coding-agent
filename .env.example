# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored — never commit real secrets.

# ── Required ──────────────────────────────────────────────────────────
# Cloud sandbox execution. Get one at https://e2b.dev/docs/getting-started/api-key
E2B_API_KEY=
# Dedicated Playwright runner template. Defaults to qualitymax-playwright when unset.
E2B_PLAYWRIGHT_TEMPLATE=qualitymax-playwright

# ── LLM providers (at least one required) ─────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Cerebras Inference (OpenAI-compatible). Runs the coding agent on gpt-oss-120b at
# ~1000+ tok/s, and powers the /recognize vision demo on gemma-4-31b. Get one at
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# ── Optional: override the default model per provider ─────────────────
# ANTHROPIC_MODEL=claude-opus-4-8
# OPENAI_MODEL=gpt-5
# GOOGLE_MODEL=gemini-3.1-pro-preview
# CEREBRAS_MODEL=gpt-oss-120b
# CEREBRAS_API_BASE=https://api.cerebras.ai/v1

# ── Optional: provider priority order (first available wins) ──────────
# ROUTER_ORDER=anthropic,openai,google,cerebras

# ── Optional: Linear MCP (pre-configured tool in the agent) ───────────
# LINEAR_API_KEY=

# ── Optional: additional MCP servers as a JSON array ──────────────────
# MCP_SERVERS=[{"name":"my-server","url":"https://...","authToken":"..."}]
